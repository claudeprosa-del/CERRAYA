---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Faq from '../../components/Faq.astro';
import FondoVivo from '../../components/FondoVivo.astro';
import CtaFinal from '../../components/CtaFinal.astro';
import { empresa, tel, whatsapp } from '../../data/empresa';
import { serviciosVidrio, urlServicio } from '../../data/servicios';
import { localidadesBogota } from '../../data/localidades';
import { sintomasVidrio, clientesVidrio, marcasVidrio } from '../../data/puertas-vidrio';
import { fotoTipo } from '../../data/fotos';
import { negocioLocal, migas } from '../../data/schema';

const url = `${empresa.sitio}/puertas-de-vidrio`;
const mensaje = 'Hola Cerraya, necesito ayuda con una puerta de vidrio';
const fotoHero = fotoTipo('puerta-vidrio');
const fotoLocal = fotoTipo('puerta-vidrio-local');
const fotoHerraje = fotoTipo('herraje-vidrio');

const preguntas = [
  { p: '¿Cuánto cuesta arreglar una puerta de vidrio?', r: 'Depende de la pieza que falló: no es lo mismo graduar una bisagra que cambiarla o cambiar una cerradura. Con una foto o un video por WhatsApp te damos un valor estimado antes de ir, y si al llegar algo cambia, tú lo apruebas antes.' },
  { p: '¿Atienden puertas de vidrio de noche y en festivos?', r: 'Sí. Si tu local u oficina no puede cerrar, salimos de inmediato a cualquier hora, todos los días del año.' },
  { p: '¿Hay que cambiar el vidrio si la puerta se descolgó?', r: 'Casi nunca. Lo normal es que falle un herraje, el pivote o la bisagra de piso. Se cambia la pieza y se nivela la hoja.' },
  { p: '¿Trabajan con conjuntos, edificios y empresas?', r: 'Sí. Tenemos planes de mantenimiento con visitas programadas, informe de estado y atención prioritaria para porterías, lobbies y locales.' },
  { p: '¿En qué zonas atienden?', r: `En las ${localidadesBogota.length} localidades de Bogotá. Escríbenos tu barrio y te decimos cuánto tardamos en llegar.` },
];

const schema = [
  negocioLocal(),
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Reparación, mantenimiento e instalación de puertas de vidrio en Bogotá',
    serviceType: 'Puertas de vidrio templado',
    provider: { '@id': `${empresa.sitio}/#negocio` },
    areaServed: { '@type': 'City', name: 'Bogotá' },
    url,
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Servicios para puertas de vidrio',
      itemListElement: serviciosVidrio.map((s) => ({
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: s.titulo, url: `${empresa.sitio}${urlServicio(s.slug)}` },
      })),
    },
  },
  migas([
    { nombre: 'Inicio', url: empresa.sitio },
    { nombre: 'Puertas de vidrio', url },
  ]),
];
---
<Base
  title="Puertas de vidrio en Bogotá: reparación, bisagras hidráulicas y cerraduras 24/7 | Cerraya"
  description="Especialistas en puertas de vidrio templado en Bogotá: bisagras hidráulicas de piso, cerraduras para vidrio, herrajes, corredizas, electroimanes y mantenimiento. Locales, oficinas y conjuntos. Urgencias 24/7."
  schema={schema}
>
  <section class="hero-vid con-fondo">
    <FondoVivo />
    <div class="container hero-grid">
      <div>
        <nav class="migas" aria-label="Ruta"><a href="/">Inicio</a><span>/</span><span aria-current="page">Puertas de vidrio</span></nav>
        <span class="tag-urg">Especialistas · Urgencias 24/7</span>
        <h1>Puertas de vidrio en Bogotá: la dejamos <span>funcionando</span></h1>
        <p class="lead">Bisagras hidráulicas, cerraduras para vidrio, herrajes, corredizas y control de acceso. Si tu puerta de vidrio golpea, arrastra, se descolgó o no cierra, la dejamos funcionando.</p>
        <div class="actions">
          <a href={whatsapp(mensaje)} target="_blank" rel="noopener" class="btn btn-wa btn-lg"><Icon name="whatsapp" />Enviar foto por WhatsApp</a>
          <a href={tel} class="btn btn-accent btn-lg"><Icon name="telefono" />Llamar · {empresa.telefonoVisible}</a>
        </div>
        <ul class="hero-points">
          <li><Icon name="reloj" />Locales que no pueden quedar abiertos</li>
          <li><Icon name="precio" />Valor estimado con una foto</li>
          <li><Icon name="garantia" />Garantía en repuestos y mano de obra</li>
        </ul>
      </div>
      {fotoHero && (
        <figure class="hero-foto">
          <Image src={fotoHero} alt="Puerta de vidrio templado con herrajes en acero inoxidable" widths={[480, 800, 1100]} sizes="(max-width: 960px) 100vw, 45vw" loading="eager" />
        </figure>
      )}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">¿Qué le pasa a tu puerta?</span>
        <h2>Dinos el síntoma, nosotros sabemos la causa</h2>
        <p class="lead">Estas son las fallas que más vemos en puertas de vidrio templado. Toca la tuya para ver cómo la resolvemos.</p>
      </div>
      <div class="grid grid-3">
        {sintomasVidrio.map((s) => (
          <a class="card sintoma" href={s.href}>
            <h3>{s.sintoma}</h3>
            <p>{s.causa}</p>
            <span class="ver">Cómo lo resolvemos<Icon name="flecha" /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-cream">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Servicios</span>
        <h2>Todo para puertas de vidrio, con un solo técnico</h2>
      </div>
      <div class="grid grid-3">
        {serviciosVidrio.map((s) => (
          <a class="card feature serv" href={urlServicio(s.slug)}>
            <span class="icon-badge"><Icon name={s.icono} /></span>
            <h3>{s.titulo}</h3>
            <p>{s.texto}</p>
            {s.urgencia && <span class="tag-24">24/7</span>}
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container grid grid-2 clientes">
      <div>
        <span class="eyebrow">A quién atendemos</span>
        <h2>De la vitrina del local a la portería del conjunto</h2>
        <ul class="lista-clientes">
          {clientesVidrio.map((c) => <li><strong>{c.titulo}</strong><span>{c.texto}</span></li>)}
        </ul>
        <p class="marcas">Trabajamos herrajes y bisagras de {marcasVidrio.join(', ')} y otras marcas del mercado.</p>
      </div>
      <div class="fotos-lado">
        {fotoLocal && <Image src={fotoLocal} alt="Fachada de local comercial con puerta de vidrio" widths={[480, 800]} sizes="(max-width: 960px) 100vw, 40vw" />}
        {fotoHerraje && <Image src={fotoHerraje} alt="Manija y herraje en acero inoxidable de una puerta de vidrio" widths={[480, 800]} sizes="(max-width: 960px) 100vw, 40vw" />}
      </div>
    </div>
  </section>

  <section class="section section-green">
    <div class="container empresas">
      <div>
        <span class="eyebrow">Conjuntos, edificios y empresas</span>
        <h2>Plan de mantenimiento para tus puertas de vidrio</h2>
        <p class="lead">Visitas programadas, informe de estado de cada puerta y atención prioritaria cuando algo falla. Prevenir una bisagra cuesta mucho menos que cambiarla.</p>
      </div>
      <div class="actions">
        <a class="btn btn-accent btn-lg" href="/mantenimiento">Ver planes<Icon name="flecha" /></a>
        <a class="btn btn-ghost btn-lg" href={whatsapp('Hola Cerraya, quiero una visita técnica para las puertas de vidrio de mi conjunto/empresa')} target="_blank" rel="noopener"><Icon name="whatsapp" />Pedir visita técnica</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Cobertura</span>
        <h2>Puertas de vidrio en todas las localidades de Bogotá</h2>
      </div>
      <ul class="chips enlaces">{localidadesBogota.map((l) => <li><a href={`/puertas-de-vidrio/${l.slug}`}>Puertas de vidrio en {l.nombre}</a></li>)}</ul>
    </div>
  </section>

  <section class="section section-cream">
    <div class="narrow">
      <div class="section-head">
        <span class="eyebrow">Preguntas frecuentes</span>
        <h2>Sobre puertas de vidrio</h2>
      </div>
      <Faq preguntas={preguntas} />
    </div>
  </section>

  <CtaFinal titulo="¿Tu puerta de vidrio no cierra?" texto="Mándanos una foto o un video por WhatsApp y en minutos te decimos qué tiene y cuánto cuesta." />
</Base>

<style>
  .hero-vid { background: linear-gradient(180deg, var(--green-800), var(--green-900)); color: var(--on-green); padding: 2rem 0 clamp(2.5rem, 6vw, 4rem); }
  .hero-grid { display: grid; grid-template-columns: 1.15fr 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .hero-vid h1 { color: var(--cream); }
  .hero-vid h1 span { color: var(--accent); }
  .hero-vid .lead { color: var(--on-green-muted); max-width: 60ch; }
  .hero-vid .actions { margin-top: 1.5rem; }
  .hero-foto { margin: 0; }
  .hero-foto :global(img) { width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; border-radius: var(--radius); box-shadow: var(--shadow); }
  .migas { display: flex; flex-wrap: wrap; gap: .5rem; font-size: .88rem; color: var(--on-green-muted); margin-bottom: 1.25rem; }
  .migas a { color: var(--cream); }
  .tag-urg { display: inline-block; margin-bottom: .9rem; padding: .25rem .75rem; border-radius: 999px; background: var(--accent); color: var(--accent-ink); font-size: .78rem; font-weight: 800; }
  .hero-points { list-style: none; padding: 0; margin: 1.5rem 0 0; display: flex; flex-wrap: wrap; gap: .6rem 1.5rem; font-size: .93rem; color: var(--cream); }
  .hero-points li { display: inline-flex; align-items: center; gap: .45rem; }
  .hero-points :global(svg) { width: 20px; height: 20px; color: var(--accent); }
  .sintoma, .serv { position: relative; text-decoration: none; display: flex; flex-direction: column; transition: border-color .18s, transform .18s; }
  .sintoma:hover, .serv:hover { border-color: var(--green-600); transform: translateY(-2px); }
  .sintoma h3 { margin-bottom: .35rem; }
  .sintoma p { color: var(--muted); margin: 0; }
  .ver { margin-top: auto; padding-top: 1rem; display: inline-flex; align-items: center; gap: .35rem; font-family: var(--display); font-weight: 700; font-size: .9rem; color: var(--green-600); }
  .ver :global(svg) { width: 18px; height: 18px; }
  .tag-24 { position: absolute; top: 1rem; right: 1rem; padding: .15rem .55rem; border-radius: 999px; background: var(--accent); color: var(--accent-ink); font-size: .72rem; font-weight: 800; }
  .clientes { align-items: center; gap: 2.5rem; }
  .lista-clientes { list-style: none; padding: 0; margin: 1.25rem 0 0; display: grid; gap: 1rem; }
  .lista-clientes li { display: grid; gap: .15rem; padding-left: 1rem; border-left: 3px solid var(--accent); }
  .lista-clientes span { color: var(--muted); font-size: .95rem; }
  .marcas { margin-top: 1.25rem; color: var(--muted); font-size: .92rem; }
  .fotos-lado { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .fotos-lado :global(img) { width: 100%; height: auto; aspect-ratio: 3 / 4; object-fit: cover; border-radius: var(--radius); }
  .empresas { display: flex; justify-content: space-between; align-items: center; gap: 2rem; flex-wrap: wrap; }
  .empresas h2 { color: var(--cream); }
  .enlaces a { text-decoration: none; color: var(--green-800); font-weight: 600; }
  @media (max-width: 960px) { .hero-grid { grid-template-columns: 1fr; } .hero-foto :global(img) { aspect-ratio: 16 / 10; } }
</style>
