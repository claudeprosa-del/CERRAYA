---
import { empresa } from '../data/empresa';
import { resenas } from '../data/resenas';

// Una reseña por tema (llegada rápida, precio, apertura sin daños, cerraduras) y dos más.
const temas = ['apertura', 'precio', 'rapidez', 'cerraduras'] as const;
const elegidas = temas.map((t) => resenas.find((r) => r.tema === t)!).filter(Boolean);
const destacadas = [...elegidas, ...resenas.filter((r) => !elegidas.includes(r))].slice(0, 6);
---
<section class="section section-cream">
  <div class="container">
    <div class="resenas">
      <a class="score-card" href={empresa.enlacePerfilGoogle} target="_blank" rel="noopener">
        <span class="score">{empresa.resenas.calificacion}</span>
        <span class="stars" aria-hidden="true">★★★★★</span>
        <span class="score-sub">{empresa.resenas.total} reseñas en Google</span>
      </a>
      <div>
        <span class="eyebrow">Opiniones</span>
        <h2>{empresa.resenas.total} clientes, {empresa.resenas.total} veces 5 estrellas</h2>
        <p class="lead">Todas nuestras reseñas en Google son de 5 estrellas. Lo que más repiten: que llegamos rápido, que la puerta quedó intacta y que cobramos lo que dijimos.</p>
        <div class="actions">
          <a class="btn btn-green" href={empresa.enlacePerfilGoogle} target="_blank" rel="noopener">Leer todas en Google</a>
          <a class="btn btn-outline" href="/resena">Calificar mi servicio</a>
        </div>
      </div>
    </div>
    <ul class="tarjetas">
      {destacadas.map((r) => (
        <li>
          <span class="stars" aria-hidden="true">★★★★★</span>
          <blockquote>“{r.texto}”</blockquote>
          <span class="autor">{r.nombre} <small>· reseña en Google</small></span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .resenas { display: grid; grid-template-columns: auto 1fr; gap: clamp(2rem, 6vw, 5rem); align-items: center; }
  .score-card {
    display: grid;
    justify-items: center;
    gap: .35rem;
    padding: 2rem 2.5rem;
    border-radius: var(--radius);
    background: var(--green-800);
    color: var(--cream);
    text-decoration: none;
    box-shadow: var(--shadow);
    transition: transform .2s;
  }
  .score-card:hover { transform: translateY(-3px); }
  .score { font-family: var(--display); font-weight: 800; font-size: 4rem; line-height: 1; }
  .score-card .stars { font-size: 1.4rem; color: #f2b33d; }
  .score-sub { font-size: .9rem; color: var(--on-green-muted); }
  .tarjetas { list-style: none; padding: 0; margin: 2.5rem 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .tarjetas li { display: flex; flex-direction: column; gap: .6rem; padding: 1.25rem; border-radius: var(--radius-sm); background: var(--white); border: 1px solid var(--line); }
  .tarjetas .stars { color: #f2b33d; letter-spacing: .05em; }
  .tarjetas blockquote { margin: 0; font-size: .97rem; line-height: 1.5; }
  .autor { margin-top: auto; font-weight: 700; font-size: .9rem; color: var(--green-800); }
  .autor small { font-weight: 500; color: var(--muted); }
  @media (max-width: 900px) { .tarjetas { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 760px) { .resenas { grid-template-columns: 1fr; } .score-card { justify-self: start; } }
  @media (max-width: 560px) { .tarjetas { grid-template-columns: 1fr; } }
</style>
